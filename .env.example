# =========================================================================== #
# BeeWatch AI — configurazione
# =========================================================================== #
#
# Copia questo file in `.env` e compila i valori.
#
#     Windows      copy .env.example .env
#     macOS/Linux  cp .env.example .env
#
# `.env` NON va mai committato: contiene le tue credenziali vere.
# Se per errore ne committi una, rigenerala subito: rimuoverla con un commit
# successivo non serve, resta nella cronologia.
#
# I valori qui sotto sono fittizi ma nel formato giusto.


# --------------------------------------------------------------------------- #
# Database MySQL
# --------------------------------------------------------------------------- #
# È lo storage primario del progetto. Con docker compose il valore di DB_HOST
# diventa il nome del servizio (es. `mysql`) invece di localhost.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=beewatch
DB_USER=beewatch
DB_PASSWORD=cambiami_con_una_password_vera


# --------------------------------------------------------------------------- #
# Modello di linguaggio
# --------------------------------------------------------------------------- #
# LLM_PROVIDER accetta due valori:
#
#   ollama      gira in locale, gratis, e le note di ispezione non escono dal
#               tuo computer. È la scelta predefinita e quella che citiamo in
#               docs/etica.md come mitigazione concreta sulla privacy.
#
#   openrouter  gira nel cloud, richiede LLM_API_KEY. Utile per la demo se la
#               macchina non regge il modello in locale.

LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b

# Obbligatoria solo con LLM_PROVIDER=openrouter. Con ollama lasciala vuota.
LLM_API_KEY=

# Secondi di attesa massima per una risposta del modello (5–600).
LLM_TIMEOUT=60


# --------------------------------------------------------------------------- #
# Modello di machine learning
# --------------------------------------------------------------------------- #
# Percorso relativo alla radice del progetto. Il file nasce in M4-T7: fino ad
# allora questo valore indica solo dove verrà salvato.

MODEL_PATH=models/produzione_v1.joblib


# --------------------------------------------------------------------------- #
# Log
# --------------------------------------------------------------------------- #
# Uno fra: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# In sviluppo DEBUG è comodo; per la demo usa INFO, altrimenti il terminale
# scorre troppo e non si legge niente.

LOG_LEVEL=INFO
